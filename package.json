{
  "name": "versal",
  "private": true,
  "type": "module",
  "description": "Versal: a browser roguelike drawn as an ink map. No build step; tests run with Node's own runner.",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "test:browser": "node tests/browser/smoke.mjs",
    "test:maps": "node tests/browser/maps.mjs",
    "maps:record": "node tests/browser/maps.mjs --record",
    "test:view": "node tests/browser/view.mjs",
    "test:light": "node tests/browser/light.mjs",
    "view:record": "node tests/browser/view.mjs --record",
    "test:deep": "LEVEL_SEEDS=500 BOT_RUNS=250 node --test \"tests/*.test.js\"",
    "lock:record": "node tools/record-lock.mjs",
    "balance": "node tools/balance.mjs --write",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "9.33.0",
    "globals": "15.14.0"
  }
}
